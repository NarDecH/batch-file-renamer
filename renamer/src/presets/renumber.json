{
  "version": 1,
  "name": "renumber",
  "description": "Shift numbers embedded in file names relative to their old value (e.g. +25 or -30)",
  "rules": [
    {
      "params": {
        "type": "renumber",
        "offset": 1,
        "target": "first",
        "pad": 4,
        "floor_one": false
      },
      "enabled": true,
      "apply_to": null,
      "only_if_glob": null
    }
  ]
}
