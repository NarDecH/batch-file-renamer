{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Batch Renamer",
  "version": "0.10.0",
  "identifier": "dev.codebuff.batchrenamer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Batch File Renamer",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA4NDU1QjY5OTQ0RDFDMzYKUldRMkhFMlVhVnRGQ0VQOEE5MnZEeXlNazVzL1k0RldTUmx6MUJOS01BTVd6ZVlLN09BaHdMbHEK",
      "endpoints": [
        "https://github.com/NarDecH/batch-file-renamer/releases/latest/download/latest.json"
      ]
    }
  }
}